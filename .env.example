# Copy this file to .env or export the variables in your shell.
# Replace every placeholder; do not commit the resulting secrets.

# Used by Docker Compose to initialize PostgreSQL. Generate a URL-safe password.
POSTGRES_DB=hospitalitysync
POSTGRES_USER=hospitalitysync
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD

# Used when running FastAPI or Alembic directly on the host.
# Docker Compose overrides DATABASE_URL inside the app container and uses db as host.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Generate a random value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
# false is required for local HTTP. Use true behind HTTPS in production.
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=28800
DEVICE_COOKIE_MAX_AGE_SECONDS=31536000
